{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(assets|css|js|components|pages|services|utils)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/items", "destination": "/items.html" },
    { "source": "/incoming", "destination": "/incoming.html" },
    { "source": "/outgoing", "destination": "/outgoing.html" },
    { "source": "/history", "destination": "/history.html" },
    { "source": "/reports", "destination": "/reports.html" }
  ]
}
